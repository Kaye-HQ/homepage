	year = {2020},
	note = {CNKICite: 18
{\textless}北大核心, CSCD{\textgreater}},
	keywords = {MSWEP, precipitation datasets, CMFD, IMERG, Yalong River basin, 降水产品, 雅砻江},
	pages = {14--21},
	file = {黄琦 et al_2020_三种降水产品在雅砻江流域的时空适用性研究.pdf:C\:\\Users\\tjzs\\Zotero\\storage\\ULVEKDER\\黄琦 et al_2020_三种降水产品在雅砻江流域的时空适用性研究.pdf:application/pdf},
