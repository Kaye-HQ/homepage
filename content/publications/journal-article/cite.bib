	volume = {51},
	copyright = {All rights reserved},
	issn = {0559-9350},
	url = {https://kns.cnki.net/kcms/detail/detail.aspx?filename=SLXB202002011&dbcode=CJFD&dbname=CJFD2020&v=Oq509-yMH6LHAkUyPGZBMeR9h-OrhZssZDSyqz8fQb8fwIoTgaW6fjm0ZOzWuNXn},
	doi = {10.13243/j.cnki.slxb.20190876},
	abstract = {综合评价了全球性降水数据MSWEP（Multi-Source Weighted-Ensemble Precipitation）在祁连山区的适用性,解析了其在不同时空尺度上的误差特征,采用结合地面雨量资料GSOD（Global Surface Summary of the Day）订正后的MSWEP（Corrected MSWEP, COMSWEP）,重点探讨了祁连山地区降水的垂直分布特性。结果表明:（1）MSWEP在日、月、年等尺度上总体低估了研究区域地表降水,对暴雨及以上日降水事件存在比较严重的漏报,在雨季的精度要明显高于旱季;（2）相对于MSWEP,COMSWEP在各种时间尺度上与地表降水更为吻合,对雨季降水和年降水具有较好估计效果,但在旱季仍存在较明显系统偏差;（3）MSWEP和COMSWEP均表明祁连山区多年平均降水量在空间上呈由东至西递减、北坡略高于南坡的总体格局,而在时程上雨季降水主导了全年降水,但在不同分区和时间尺度上,COMSWEP降水量均明显高于MSWEP;（4）MSWEP和COMSWEP均反映祁连山地区东段最大降水高度带在3000 m左右,超过此高度带多年平均降水量变化甚小,而中段和西段多年平均降水量随海拔呈现先增加后降低的趋势,最大降水高度带分别位于4100 m和4500 m左右。},
	language = {zh},
	number = {2},
	urldate = {2023-01-27},
	journal = {水利学报},
	author = {{黄琦} and {覃光华} and {王瑞敏} and {向俊燕} and {胡庆芳} and {李伶杰}},
	year = {2020},
	note = {CNKICite: 24
{\textless}北大核心, EI, CSCD{\textgreater}},
	keywords = {precipitation, MSWEP, 降水, 空间分布, correction, GSOD, Qilian Mountain, spatial distribution, 祁连山区, 订正},
	pages = {232--244},
	file = {黄琦 et al_2020_基于MSWEP的祁连山地区降水空间分布特性解析.pdf:C\:\\Users\\tjzs\\Zotero\\storage\\82LS2EAQ\\黄琦 et al_2020_基于MSWEP的祁连山地区降水空间分布特性解析.pdf:application/pdf},
}

@article{__2021,
	title = {基于再分析降水与融雪模块的雅砻江上游径流模拟研究},
	copyright = {All rights reserved},
	issn = {1007-2284},
	url = {https://kns.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&dbname=CJFDLAST2022&filename=ZNSD202105022&uniplatform=NZKPT&v=TJY8uh1lAbOUK1fnzC0j3Wy7mL7dlDlJpmLQjrab5NlkGrdmcZqTp1a-0PgfYhee},
	abstract = {雅砻江中下游地区建设有众多水利水电工程,采用合适的降水产品建立雅砻江上游径流模拟预报模型,对下游的水电资源开发有重大意义。研究区域为雅砻江新龙水文站以上的上游地区,从模型结构和数据输入两方面对研究区径流模拟进行改进研究。首先以地面降水[中国地面气候资料日值数据集（V3.0）中的降水]为基准,对中国区域高时空分辨率地面气象要素驱动数据集（China Meteorological Forcing Dataset,CMFD）中的降水（CMFD-P）进行评估,然后,分别采用CMFD-P和地面降水为输入运行三水源集总式新安江模型和含融雪模块的集总式新安江模型,模拟研究区出口日径流过程。结果表明:CMFD-P在研究区与站点降水一致性较高;含融雪模块的三水源新安江模型大大提升了三水源新安江模型的模拟能力;采用含融雪模块的三水源新安江模型模拟径流时,CMFD-P降水模拟结果优于站点降水模拟结果,能更好地模拟春季径流。研究成果对研究区径流模拟及预报工作具有数据选择和模型优化方面的实际参考意义。},
	language = {zh},
	number = {5},
	urldate = {2023-01-27},
	journal = {中国农村水利水电},
	author = {{黄琦} and {覃光华} and {向俊燕} and {王瑞敏}},
	year = {2021},
	note = {CNKICite: 3
{\textless}北大核心{\textgreater}},
	keywords = {新安江模型, Xinanjiang model, 径流模拟, runoff simulation, CMFD, upstream of Yalong River, 雅砻江上游},
	pages = {125--132},
	file = {黄琦 et al_2021_基于再分析降水与融雪模块的雅砻江上游径流模拟研究.pdf:C\:\\Users\\tjzs\\Zotero\\storage\\YTJKVGES\\黄琦 et al_2021_基于再分析降水与融雪模块的雅砻江上游径流模拟研究.pdf:application/pdf},
}

